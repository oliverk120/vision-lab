{
  // Run and Debug panel (or F5): "Run Vision Lab" runs the website in a terminal.
  // It first stops the automatically started background copy, so only one server exists.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Vision Lab",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "./scripts/vision-lab.sh run"
    }
  ]
}
