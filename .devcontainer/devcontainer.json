{
  "name": "Vision Lab (CPU)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // pip installs uv into ~/.local/bin; put it on PATH for lifecycle commands and terminals.
  "remoteEnv": {"PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"},
  // One-time setup when the Codespace is created ("python -m uv" works even without PATH).
  "postCreateCommand": "python -m pip install --user uv==0.12.23 && python -m uv sync --locked",
  // Runs on every start, including resuming a stopped Codespace. Safe to repeat: never starts a second server.
  "postStartCommand": "bash scripts/vision-lab.sh start",
  // Runs whenever VS Code connects, restarting the website if it was stopped in the meantime.
  "postAttachCommand": "bash scripts/vision-lab.sh start",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {"label": "Vision Lab", "onAutoForward": "openBrowserOnce", "visibility": "private"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}
    }
  }
}
