{
  "name": "Vision Lab (CPU)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install uv==0.12.23 && uv sync --locked",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "Vision Lab", "onAutoForward": "notify", "visibility": "private"}},
  "customizations": {"vscode": {"extensions": ["ms-python.python"], "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}}}
}
