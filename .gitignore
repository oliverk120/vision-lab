# Private media, datasets, and generated run artifacts: preserve empty roots only.
/data/*
!/data/.gitkeep
/runs/*
!/runs/.gitkeep

# Recordings and model artifacts accidentally placed elsewhere (case-insensitive).
*.[mM][pP]4
*.[mM][oO][vV]
*.m4v
*.avi
*.mkv
*.webm
*.mpeg
*.mpg
*.mts
*.m2ts
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.tflite
*.npy
*.npz

# Local secrets and credentials; sanitized examples may be committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.toml
.streamlit/secrets.toml
.aws/
.ssh/

# Python environments, caches, build/test outputs.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/
.ipynb_checkpoints/
*.log

# Editor and operating-system local files.
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~
